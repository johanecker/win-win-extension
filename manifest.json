{
  "manifest_version": 3,
  "name": "Win Win",
  "version": "1.0.3",
  "description": "Balanced windows for multitasking.",
  "minimum_chrome_version": "102",
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_popup": "winwin.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["system.display", "tabGroups"]
}
